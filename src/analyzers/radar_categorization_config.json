{
  "ring_rules": {
    "adopt": {
      "min_repo_count": 25,
      "min_time_in_use_days": 180,
      "conditions": "all"
    },
    "trial": {
      "min_repo_count": 5,
      "min_time_in_use_days": 90,
      "conditions": "all"
    },
    "assess": {
      "min_repo_count": 2,
      "conditions": "all"
    },
    "hold": {
      "description": "Single-use, deprecated, or high-risk"
    }
  },
  "quadrant_mapping": {
    "language": "Languages & Frameworks",
    "framework": "Languages & Frameworks",
    "database": "Platforms",
    "infrastructure": "Infrastructure",
    "docker": "Infrastructure",
    "ci_cd": "Tools",
    "build_tool": "Tools"
  },
  "exclusions": [
    "test-package-*",
    "internal-*"
  ]
}
