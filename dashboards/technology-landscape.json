{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "title": "Language & Framework Overview",
      "type": "row"
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "right"}, "pieType": "pie", "tooltip": {"mode": "single"}},
      "title": "Top Languages by Repo Count",
      "type": "piechart",
      "targets": [
        {
          "datasource": "${datasource}",
          "rawSql": "SELECT name AS metric, COUNT(DISTINCT repo_id) AS value\nFROM repository_stack\nWHERE category = 'language'\nGROUP BY name\nORDER BY value DESC\nLIMIT 10;",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "right"}, "pieType": "pie", "tooltip": {"mode": "single"}},
      "title": "Top Frameworks by Repo Count",
      "type": "piechart",
      "targets": [
        {
          "datasource": "${datasource}",
          "rawSql": "SELECT name AS metric, COUNT(DISTINCT repo_id) AS value\nFROM repository_stack\nWHERE category = 'framework'\nGROUP BY name\nORDER BY value DESC\nLIMIT 10;",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Distinct Technologies",
      "type": "stat",
      "targets": [
        {
          "datasource": "${datasource}",
          "rawSql": "SELECT COUNT(DISTINCT name) AS value FROM repository_stack WHERE category != 'language';",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {"defaults": {"unit": "short", "color": {"fixedColor": "red", "mode": "fixed"}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "EOL Technologies",
      "type": "stat",
      "targets": [
        {
          "datasource": "${datasource}",
          "rawSql": "SELECT COUNT(*) AS value FROM technologies WHERE is_eol = TRUE;",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 6,
      "title": "EOL & Risk",
      "type": "row"
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 10},
      "id": 7,
      "options": {"showHeader": true, "sortBy": []},
      "title": "EOL Technologies with Affected Repo Count",
      "type": "table",
      "targets": [
        {
          "datasource": "${datasource}",
          "rawSql": "SELECT t.name, t.category, t.eol_date, t.latest_supported_version,\n       COUNT(DISTINCT rs.repo_id) AS affected_repos\nFROM technologies t\nJOIN repository_stack rs ON rs.name = t.name AND rs.category = t.category\nWHERE t.is_eol = TRUE\n   OR (t.eol_date IS NOT NULL AND t.eol_date <= CURRENT_DATE + INTERVAL '90 days')\nGROUP BY t.name, t.category, t.eol_date, t.latest_supported_version\nORDER BY t.eol_date NULLS LAST, t.name;",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {"defaults": {"unit": "short", "color": {"fixedColor": "orange", "mode": "fixed"}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 18},
      "id": 8,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Repos Using EOL Technology",
      "type": "stat",
      "targets": [
        {
          "datasource": "${datasource}",
          "rawSql": "SELECT COUNT(DISTINCT rs.repo_id) AS value\nFROM repository_stack rs\nJOIN technologies t ON t.name = rs.name AND t.category = rs.category\nWHERE t.is_eol = TRUE;",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "id": 9,
      "title": "Repository Stack Heatmap",
      "type": "row"
    },
    {
      "datasource": "${datasource}",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 23},
      "id": 10,
      "options": {"showHeader": true, "sortBy": []},
      "title": "Repository Stack (by source)",
      "type": "table",
      "targets": [
        {
          "datasource": "${datasource}",
          "rawSql": "SELECT rs.repo_id, rs.category, rs.name, rs.source,\n       t.is_eol, t.eol_date\nFROM repository_stack rs\nLEFT JOIN technologies t ON t.name = rs.name AND t.category = rs.category\nORDER BY rs.repo_id, rs.category, rs.name\nLIMIT 200;",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 36,
  "tags": ["technology", "stack", "eol"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "grafana-postgresql-datasource",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-30d", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Technology Landscape",
  "uid": "technology-landscape",
  "version": 1,
  "weekStart": ""
}
