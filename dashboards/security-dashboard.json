      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  r.name as \"Repository\",\n  COALESCE(vuln_counts.critical, 0) as \"Critical Vulns\",\n  COALESCE(vuln_counts.high, 0) as \"High Vulns\",\n  COALESCE(vuln_counts.medium, 0) as \"Medium Vulns\",\n  COALESCE(vuln_counts.low, 0) as \"Low Vulns\",\n  COALESCE(eol_counts.eol_deps, 0) as \"EOL Deps\"\nFROM repositories r\nLEFT JOIN (\n  SELECT \n    d.repo_id,\n    SUM(CASE WHEN v.severity = 'CRITICAL' THEN 1 ELSE 0 END) as critical,\n    SUM(CASE WHEN v.severity = 'HIGH' THEN 1 ELSE 0 END) as high,\n    SUM(CASE WHEN v.severity = 'MEDIUM' THEN 1 ELSE 0 END) as medium,\n    SUM(CASE WHEN v.severity = 'LOW' THEN 1 ELSE 0 END) as low\n  FROM vulnerabilities v\n  JOIN dependencies d ON v.dependency_id = d.id\n  WHERE d.analyzed_at = (\n    SELECT MAX(analyzed_at) FROM dependencies d2 WHERE d2.repo_id = d.repo_id\n  )\n  GROUP BY d.repo_id\n) vuln_counts ON r.repo_id = vuln_counts.repo_id\nLEFT JOIN (\n  SELECT \n    repo_id,\n    COUNT(*) as eol_deps\n  FROM dependencies\n  WHERE is_eol = true\n    AND analyzed_at = (\n      SELECT MAX(analyzed_at) FROM dependencies d2 WHERE d2.repo_id = dependencies.repo_id\n    )\n  GROUP BY repo_id\n) eol_counts ON r.repo_id = eol_counts.repo_id\nWHERE r.is_active = true\nORDER BY (COALESCE(vuln_counts.critical, 0) + COALESCE(vuln_counts.high, 0)) DESC;",
          "refId": "A"
        }
      ],
      "title": "Repository Security Overview",
      "type": "table"
    },
