        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  CASE \n    WHEN eol_date < CURRENT_DATE THEN 'Expired'\n    WHEN eol_date < CURRENT_DATE + INTERVAL '90 days' THEN 'Expiring Soon'\n    ELSE 'Future EOL'\n  END as category,\n  COUNT(*) as count\nFROM dependencies\nWHERE is_eol = true\n  AND analyzed_at = (\n    SELECT MAX(analyzed_at) FROM dependencies\n  )\nGROUP BY category\nORDER BY \n  CASE category \n    WHEN 'Expired' THEN 1 \n    WHEN 'Expiring Soon' THEN 2 \n    WHEN 'Future EOL' THEN 3 \n  END;",
          "refId": "A"
        }
      ],
      "title": "EOL Dependency Status",
      "type": "piechart"
