          "rawSql": "SELECT \n  d.package_name as \"Package\",\n  d.version as \"Version\",\n  d.ecosystem as \"Ecosystem\",\n  v.severity as \"Severity\",\n  COUNT(DISTINCT d.repo_id) as \"Affected Repositories\",\n  STRING_AGG(DISTINCT r.name, ', ') as \"Repositories\"\nFROM vulnerabilities v\nJOIN dependencies d ON v.dependency_id = d.id\nJOIN repositories r ON d.repo_id = r.repo_id\nWHERE d.analyzed_at = (\n  SELECT MAX(analyzed_at) FROM dependencies d2 WHERE d2.repo_id = d.repo_id\n)\nGROUP BY d.package_name, d.version, d.ecosystem, v.severity\nORDER BY \n  CASE v.severity \n    WHEN 'CRITICAL' THEN 1 \n    WHEN 'HIGH' THEN 2 \n    WHEN 'MEDIUM' THEN 3 \n    WHEN 'LOW' THEN 4 \n  END,\n  COUNT(DISTINCT d.repo_id) DESC\nLIMIT 20;",
          "refId": "A"
        }
      ],
      "title": "Top Vulnerable Dependencies",
      "type": "table"
    }
  ],
