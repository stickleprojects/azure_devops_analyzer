          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  r.name as repository,\n  COUNT(*) as critical_vulns\nFROM vulnerabilities v\nJOIN dependencies d ON v.dependency_id = d.id\nJOIN repositories r ON d.repo_id = r.repo_id\nWHERE v.severity = 'CRITICAL'\n  AND d.analyzed_at = (\n    SELECT MAX(analyzed_at) FROM dependencies d2 WHERE d2.repo_id = d.repo_id\n  )\nGROUP BY r.name\nORDER BY critical_vulns DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top 10 Repositories by Critical Vulnerabilities",
      "type": "barchart"
