          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n  date_trunc('day', commit_date) as time,\n  COUNT(*) as commits\nFROM commits\nWHERE commit_date > NOW() - INTERVAL '30 days'\nGROUP BY date_trunc('day', commit_date)\nORDER BY time;",
          "refId": "A"
        }
      ],
      "title": "Commit Activity (Last 30 Days)",
