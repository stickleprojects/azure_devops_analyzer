      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  r.name as repository,\n  o.name as organization,\n  r.default_branch,\n  r.url,\n  r.last_analyzed_at,\n  (SELECT COUNT(*) FROM commits c WHERE c.repo_id = r.repo_id) as total_commits,\n  (SELECT COUNT(*) FROM pull_requests p WHERE p.repo_id = r.repo_id) as total_prs\nFROM repositories r\nJOIN projects p ON r.project_id = p.project_id\nJOIN organizations o ON p.organization_id = o.organization_id\nWHERE r.is_active = true\nORDER BY r.last_analyzed_at DESC NULLS LAST;",
          "refId": "A"
        }
      ],
      "title": "All Repositories",
      "type": "table"
