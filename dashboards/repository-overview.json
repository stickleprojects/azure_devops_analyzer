      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  r.name as repository,\n  COUNT(c.commit_sha) as commits,\n  r.url\nFROM repositories r\nLEFT JOIN commits c ON r.repo_id = c.repo_id \n  AND c.commit_date > NOW() - INTERVAL '30 days'\nWHERE r.is_active = true\nGROUP BY r.repo_id, r.name, r.url\nORDER BY commits DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top 10 Active Repositories (Last 30 Days)",
      "type": "table"
