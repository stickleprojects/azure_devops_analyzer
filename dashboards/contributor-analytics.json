      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  COALESCE(c.name, c.email) as contributor,\n  c.email,\n  COUNT(DISTINCT cm.commit_sha) as commits,\n  COALESCE(SUM(cm.lines_added), 0) as lines_added,\n  COALESCE(SUM(cm.lines_removed), 0) as lines_removed,\n  COUNT(DISTINCT pr.id) as prs_authored,\n  COUNT(DISTINCT r.id) as reviews_given\nFROM contributors c\nLEFT JOIN commits cm ON c.id = cm.author_id AND cm.commit_date > NOW() - INTERVAL '30 days'\nLEFT JOIN pull_requests pr ON c.id = pr.author_id AND pr.created_at > NOW() - INTERVAL '30 days'\nLEFT JOIN pr_reviews r ON c.id = r.reviewer_id AND r.review_date > NOW() - INTERVAL '30 days'\nGROUP BY c.id, c.name, c.email\nHAVING COUNT(DISTINCT cm.commit_sha) > 0 OR COUNT(DISTINCT pr.id) > 0 OR COUNT(DISTINCT r.id) > 0\nORDER BY commits DESC;",
          "refId": "A"
        }
      ],
      "title": "Contributor Activity Summary (30 Days)",
      "type": "table"
    }
