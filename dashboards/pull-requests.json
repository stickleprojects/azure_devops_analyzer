          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n  date_trunc('day', created_at) as time,\n  COUNT(*) as created\nFROM pull_requests\nWHERE created_at > NOW() - INTERVAL '30 days'\nGROUP BY date_trunc('day', created_at)\nORDER BY time;",
