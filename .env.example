# ===========================================
# Repository Analyzer - Environment Variables
# ===========================================
# Supports: Azure DevOps, GitHub
# Copy this file to .env and fill in your values

# -----------------
# PostgreSQL/TimescaleDB Configuration
# -----------------
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=repo_analyzer
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# TimescaleDB specific
TIMESCALEDB_TELEMETRY=off

# -----------------
# RabbitMQ Configuration
# -----------------
RABBITMQ_DEFAULT_USER=analyzer
RABBITMQ_DEFAULT_PASS=changeme_rabbitmq_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Celery broker URL (constructed from above)
CELERY_BROKER_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}//

# -----------------
# Azure DevOps Configuration
# -----------------
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PAT=your_personal_access_token

# -----------------
# GitHub Configuration
# -----------------
# Personal Access Token (classic) with repo scope
GITHUB_TOKEN=your_github_personal_access_token
# Organization name (leave empty for personal repos)
GITHUB_ORG=your-organization
# Username (for personal repos, leave empty if using org)
GITHUB_USER=

# -----------------
# Application Configuration
# -----------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Number of Celery worker processes
CELERY_WORKER_CONCURRENCY=4

# -----------------
# Backup Configuration (Azure Blob Storage)
# -----------------
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_BACKUP_CONTAINER=database-backups
