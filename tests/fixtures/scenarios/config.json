  "repo_sets": [
    {
      "template": "python-docker",
      "name_template": "python-docker-{service}",
      "description_template": "Python {service} system with Docker support",
      "services": ["billing", "inventory", "payroll", "invoices", "reports"]
    },
    {
      "template": "react-spa",
      "names": ["react-spa"]
    },
    {
      "template": "java-maven-jenkins",
      "names": ["java-maven-jenkins"]
    },
    {
      "template": "fullstack-monorepo",
      "names": ["fullstack-monorepo"]
    },
    {
      "template": "legacy-migration",
      "name_template": "legacy-migration-{service}",
      "description_template": "Legacy {service} system undergoing migration",
      "services": ["billing", "inventory", "payroll"],
      "overrides": []
    },
    {
      "template": "dual-ci",
      "name_template": "dual-ci-{service}",
      "description_template": "Dual CI service for {service} domain",
      "services": [
        "auth",
        "billing",
        "catalog",
        "payments",
        "analytics",
        "notifications",
        "search",
        "orders",
        "inventory",
        "gateway"
      ],
      "overrides": []
    },
    {
      "template": "python-dual-deps",
      "names": ["python-dual-deps"]
    },
    {
      "template": "go-microservice",
      "names": ["go-microservice"]
    },
    {
      "template": "edge-case-empty",
      "name_template": "empty-{service}",
      "description_template": "Empty repository for {service} (edge case)",
      "services": ["stub", "archive", "handoff"],
      "overrides": []
    },
    {
      "template": "deep-nested-manifests",
      "names": ["deep-nested-manifests"]
    }
  ]
