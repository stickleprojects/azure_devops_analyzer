  "repo_templates": {
    "python-docker": {
      "description": "Python project with Docker support and Flask API",
      "pattern": "single-language",
      "languages": ["Python"],
      "commit_message_themes": [
        "Docker setup",
        "Flask endpoint",
        "pytest configuration",
        "requirements update",
        "CI/CD pipeline"
      ],
      "pr_title_themes": [
        "Add Docker support",
        "Improve Flask API",
        "Add unit tests",
        "Fix requirements issue",
        "Update CI/CD pipeline"
      ],
      "overrides": {}
    },
    "react-spa": {
      "description": "React single-page application with TypeScript",
      "pattern": "frontend-spa",
      "languages": ["TypeScript", "JavaScript"],
      "commit_message_themes": [
        "Add React component",
        "Update TypeScript config",
        "Refactor async/await",
        "Fix styling issues",
        "Add storybook story"
      ],
      "pr_title_themes": [
        "Add React component",
        "Improve component reusability",
        "Fix TypeScript warnings",
        "Update styling",
        "Add storybook documentation"
      ],
      "overrides": {}
    },
    "java-maven-jenkins": {
      "description": "Java project using Maven build system and Jenkins CI",
      "pattern": "single-language",
      "languages": ["Java"],
      "commit_message_themes": [
        "Add Spring component",
        "Configure Maven plugin",
        "Update dependency version",
        "Add unit test",
        "Jenkins stage setup"
      ],
      "pr_title_themes": [
        "Add Spring service",
        "Update Maven dependencies",
        "Improve test coverage",
        "Add Jenkinsfile stage",
        "Fix integration test"
      ],
      "overrides": {}
    },
    "fullstack-monorepo": {
      "description": "Monorepo with backend API and frontend services",
      "pattern": "fullstack-monorepo",
      "languages": ["Python", "TypeScript"],
      "commit_message_themes": [
        "Backend API implementation",
        "Frontend component",
        "monorepo structure",
        "shared utilities",
        "cross-service communication"
      ],
      "pr_title_themes": [
        "Add backend service",
        "Add React component",
        "Improve shared library",
        "Cross-service integration",
        "Enhance deployment pipeline"
      ],
      "overrides": {}
    },
    "legacy-migration": {
      "description": "Legacy .NET project with mixed package formats",
      "pattern": "legacy-migration",
      "languages": ["C#"],
      "commit_message_themes": [
        "Migrate to modern .csproj",
        "Update Nuget packages",
        "Remove legacy references",
        "Upgrade to new API",
        "Fix compatibility issues"
      ],
      "pr_title_themes": [
        "Migrate to modern .csproj",
        "Update Nuget packages",
        "Remove legacy references",
        "Upgrade to new API",
        "Fix compatibility issues"
      ],
      "overrides": {}
    },
    "dual-ci": {
      "description": "Dual CI: both Jenkins and GitHub Actions",
      "pattern": "dual-ci",
      "languages": ["Python"],
      "commit_message_themes": [
        "Jenkinsfile stage",
        "GitHub Actions workflow",
        "CI/CD improvement",
        "build optimization",
        "pipeline trigger fix"
      ],
      "pr_title_themes": [
        "Add Jenkins stage",
        "Add GitHub Actions workflow",
        "Improve build speed",
        "Fix CI trigger",
        "Standardize CI configuration"
      ],
      "overrides": {}
    },
    "python-dual-deps": {
      "description": "Python with both Pipfile and requirements.txt",
      "pattern": "dual-ci",
      "languages": ["Python"],
      "commit_message_themes": [
        "Pipfile lock update",
        "requirements.txt sync",
        "Dependency upgrade",
        "Fix security vulnerability",
        "Dependency cleanup"
      ],
      "pr_title_themes": [
        "Update Pipfile dependencies",
        "Sync requirements with Pipfile",
        "Update to latest stable",
        "Fix security vulnerability",
        "Remove unused dependency"
      ],
      "overrides": {}
    },
    "go-microservice": {
      "description": "Go microservice with HTTP handlers",
      "pattern": "single-language",
      "languages": ["Go"],
      "commit_message_themes": [
        "Add Gin router",
        "Implement middleware",
        "Optimize concurrency",
        "Update go.mod",
        "Improve error handling"
      ],
      "pr_title_themes": [
        "Add Gin router",
        "Implement middleware",
        "Optimize concurrency",
        "Update go.mod",
        "Improve error handling"
      ],
      "overrides": {}
    },
    "edge-case-empty": {
      "description": "Empty repository (edge case)",
      "pattern": "edge-case-empty",
      "languages": [],
      "commit_message_themes": [],
      "pr_title_themes": [],
      "overrides": {}
    },
    "deep-nested-manifests": {
      "description": "Manifests only in subdirectories",
      "pattern": "fullstack-monorepo",
      "languages": ["Python", "TypeScript"],
      "commit_message_themes": [
        "Service API implementation",
        "service structure",
        "monorepo layout",
        "package isolation",
        "cross-service communication"
