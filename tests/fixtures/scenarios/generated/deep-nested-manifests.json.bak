{
  "name": "deep-nested-manifests",
  "description": "Manifests only in subdirectories",
  "languages": [
    "Python",
    "TypeScript"
  ],
  "file_names": [
    "README.md",
    "services/backend/requirements.txt",
    "services/frontend/package.json",
    "shared/pyproject.toml",
    "services/backend/src/main.py",
    "services/frontend/src/App.tsx",
    "shared/utils.py",
    "scripts/deploy.sh",
    "terraform/main.tf"
  ],
  "manifests": {
    "python": [
      {
        "type": "services/backend/requirements.txt",
        "content": "Flask==2.3.0\nrequests==2.31.0\npython-dotenv==1.0.0"
      }
    ],
    "javascript": [
      {
        "type": "services/frontend/package.json",
        "content": "{\n  \"name\": \"frontend\",\n  \"version\": \"0.1.0\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"tsc && vite build\"\n  },\n  \"dependencies\": {\n    \"react\": \"^18.2.0\",\n    \"react-dom\": \"^18.2.0\"\n  },\n  \"devDependencies\": {\n    \"@types/react\": \"^18.0.0\",\n    \"typescript\": \"^5.0.0\",\n    \"vite\": \"^4.0.0\"\n  }\n}"
      }
    ]
  },
  "branches": [
    "main",
    "develop",
    "feature/nested-structure"
  ]
}