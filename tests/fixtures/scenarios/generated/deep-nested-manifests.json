{
  "name": "deep-nested-manifests",
  "description": "Manifests only in subdirectories",
  "languages": [
    "Python",
    "TypeScript"
  ],
  "file_names": [
    "README.md",
    "tests/test_app.py",
    "config.yaml",
    "src/index.js",
    "public/index.html",
    "package.json",
    "app.py",
    "requirements.txt",
    "tsconfig.json"
  ],
  "manifests": {
    "python": [
      {
        "type": "requirements.txt",
        "content": "# Python dependencies\nFlask==2.3.0\nrequests==2.31.0\npython-dotenv==1.0.0"
      }
    ],
    "typescript": [
      {
        "type": "tsconfig.json",
        "content": "{\n  \"compilerOptions\": {\n    \"target\": \"es6\",\n    \"module\": \"commonjs\"\n  }\n}"
      }
    ]
  },
  "branches": [
    "main",
    "develop",
    "feature/service-1",
    "feature/service-2"
  ]
}