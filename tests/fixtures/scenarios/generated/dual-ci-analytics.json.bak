{
  "name": "dual-ci-analytics",
  "description": "Dual CI service for dual-ci-analytics domain",
  "languages": [
    "Python"
  ],
  "file_names": [
    "README.md",
    "Dockerfile",
    "requirements.txt",
    "app.py",
    "tests/test_app.py",
    "config.yaml"
  ],
  "manifests": {
    "python": [
      {
        "type": "requirements.txt",
        "content": "# Python dependencies\nFlask==2.3.0\nrequests==2.31.0\npython-dotenv==1.0.0"
      }
    ]
  },
  "branches": [
    "main",
    "develop",
    "feature/docker"
  ]
}