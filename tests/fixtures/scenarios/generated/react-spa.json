{
  "name": "react-spa",
  "description": "React single-page application with TypeScript",
  "languages": [
    "TypeScript",
    "JavaScript"
  ],
  "file_names": [
    "package.json",
    "src/index.js",
    "public/index.html",
    "tsconfig.json"
  ],
  "manifests": {
    "typescript": [
      {
        "type": "tsconfig.json",
        "content": "{\n  \"compilerOptions\": {\n    \"target\": \"es6\",\n    \"module\": \"commonjs\"\n  }\n}"
      }
    ],
    "javascript": [
      {
        "type": "package.json",
        "content": "{\n  \"name\": \"example-app\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {\n    \"react\": \"^17.0.2\"\n  }\n}"
      }
    ]
  },
  "branches": [
    "main",
    "develop",
    "feature/-1"
  ]
}