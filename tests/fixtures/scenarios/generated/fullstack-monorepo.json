{
  "name": "fullstack-monorepo",
  "description": "Monorepo with backend API and frontend services",
  "languages": [
    "Python",
    "TypeScript"
  ],
  "file_names": [
    "README.md",
    "Dockerfile",
    "requirements.txt",
    "app.py",
    "tests/test_app.py",
    "config.yaml",
    "src/index.js",
    "public/index.html",
    "vite.config.ts",
    ".eslintrc.json"
  ],
  "manifests": {
    "python": [
      {
        "type": "requirements.txt",
        "content": "# Python dependencies\nFlask==2.3.0\nrequests==2.31.0\npython-dotenv==1.0.0"
      }
    ],
    "javascript": [
      {
        "type": "package.json",
        "content": "{\n  \"name\": \"react-app\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {\n    \"react\": \"^18.2.0\",\n    \"react-dom\": \"^18.2.0\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-react\": \"^3.0.0\",\n    \"vite\": \"^4.0.0\"\n  }\n}"
      }
    ]
  },
  "branches": [
    "main",
    "develop",
    "feature/docker"
  ]
}