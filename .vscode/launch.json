{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
       
        {
            "name": "PowerShell: github analysis local",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/scripts/run-githubAnalysis.ps1",
            "args": [
                "-GitHubToken",
                "%REPO_ANALYZER_GITHUB_TOKEN%"
            ]
        },
        {
            "name": "PowerShell Launch Current File",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "cwd": "${cwd}"
        }
    ]
}